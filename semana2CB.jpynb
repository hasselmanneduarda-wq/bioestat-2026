    {
      "cell_type": "code",
      "source": [
        "contagem = dados[\"Cultivar \"].value_counts()\n",
        "\n",
        "cores = [\"#6C8CD5\", \"#E889B5\", \"#9B7ED9\"]\n",
        "\n",
        "plt.figure(figsize=(7, 7))\n",
        "\n",
        "plt.pie(\n",
        "    contagem,\n",
        "    labels=contagem.index,\n",
        "    autopct=\"%1.1f%%\",\n",
        "    colors=cores,\n",
        "    startangle=90,\n",
        "    wedgeprops={\"edgecolor\": \"white\", \"linewidth\": 2},\n",
        "    textprops={\"fontsize\": 12}\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Distribuição das Cultivares de Soja\",\n",
        "    fontsize=15,\n",
        "    fontweight=\"bold\"\n",
        ")\n",
        "\n",
        "plt.legend(\n",
        "    title=\"Cultivar\",\n",
        "    loc=\"upper right\"\n",
        ")\n",
        "\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 599
        },
        "collapsed": true,
        "id": "qY6bAzFy4CG4",
        "outputId": "5f09737d-b714-4abf-b54d-6bb35d826785"
      },
      "execution_count": 30,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 700x700 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "media_vagens = dados.groupby(\"Cultivar \")[\"N de vagens\"].mean()\n",
        "\n",
        "cores = [\"#6C8CD5\", \"#E889B5\", \"#9B7ED9\"]\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "barras = plt.bar(\n",
        "    media_vagens.index,\n",
        "    media_vagens.values,\n",
        "    color=cores,\n",
        "    edgecolor=\"white\",\n",
        "    linewidth=1.5\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Nº Médio de Vagens por Cultivar de Soja\",\n",
        "    fontsize=15,\n",
        "    fontweight=\"bold\",\n",
        "    pad=15\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Cultivar \", fontsize=12)\n",
        "plt.ylabel(\"Nº médio de vagens\", fontsize=12)\n",
        "\n",
        "for barra in barras:\n",
        "    altura = barra.get_height()\n",
        "    plt.text(\n",
        "        barra.get_x() + barra.get_width()/2,\n",
        "        altura + 0.5,\n",
        "        f\"{altura:.1f}\",\n",
        "        ha=\"center\",\n",
        "        fontsize=11\n",
        "    )\n",
        "\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 502
        },
        "id": "aD0KF-pu8Qiu",
