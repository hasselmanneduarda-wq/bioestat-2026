    {
      "cell_type": "code",
      "source": [
        "prod_A = dados.loc[dados[\"Cultivar \"] == \"A\", \"Produtividade (kg/ha)\"]\n",
        "prod_B = dados.loc[dados[\"Cultivar \"] == \"B\", \"Produtividade (kg/ha)\"]\n",
        "prod_C = dados.loc[dados[\"Cultivar \"] == \"C\", \"Produtividade (kg/ha)\"]\n",
        "\n",
        "cores = [\"#6C8CD5\", \"#E889B5\", \"#9B7ED9\"]\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "box = plt.boxplot(\n",
        "    [prod_A, prod_B, prod_C],\n",
        "    tick_labels=[\"A\", \"B\", \"C\"],\n",
        "    patch_artist=True\n",
        ")\n",
        "\n",
        "for caixa, cor in zip(box[\"boxes\"], cores):\n",
        "    caixa.set_facecolor(cor)\n",
        "\n",
        "plt.title(\n",
        "    \"Produtividade por Cultivar de Soja\",\n",
        "    fontsize=15,\n",
        "    fontweight=\"bold\",\n",
        "    pad=15\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Cultivar \", fontsize=12)\n",
        "plt.ylabel(\"Produtividade (kg/ha)\", fontsize=12)\n",
        "\n",
        "plt.show()"
      ],
